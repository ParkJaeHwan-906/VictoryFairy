# EC2 크론용 py-collector 환경변수 예시.
# 실값은 ~/app/collector/collector.env 에 두고 절대 커밋하지 말 것.
# records/registrations 잡은 DB 에만 쓰므로 S3 설정은 필요 없다.
COLLECTOR_DB_HOST=<rds-endpoint>.ap-northeast-2.rds.amazonaws.com
COLLECTOR_DB_PORT=3306
COLLECTOR_DB_NAME=victoryfairy
COLLECTOR_DB_USER=vf
COLLECTOR_DB_PASSWORD=<password>
