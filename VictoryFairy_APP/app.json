{
  "expo": {
    "name": "승리요정",
    "slug": "victory-fairy",
    "scheme": "victoryfairy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.victoryfairy.mobile",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram-stories"],
        "NSCameraUsageDescription": "프로필 사진을 촬영하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "프로필 사진을 선택하기 위해 사진 보관함에 접근합니다.",
        "NSMicrophoneUsageDescription": "카메라로 촬영할 때 마이크 접근이 필요할 수 있습니다."
      }
    },
    "android": {
      "package": "com.victoryfairy.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "android": {
            "imageWidth": 192
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F04E23",
          "defaultChannel": "game-reminder"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4f5d1c18-a705-45a3-9e3b-fd7c48ddce09"
      }
    },
    "owner": "victoryfairy"
  }
}
