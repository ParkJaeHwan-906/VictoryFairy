# 이 파일을 복사해 terraform.tfvars 로 만들어 사용하세요.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars 는 .gitignore 로 커밋되지 않습니다 (시크릿 보관 가능).

aws_region       = "ap-northeast-2"
environment      = "dev"
vpc_cidr         = "10.0.0.0/16"
azs              = ["ap-northeast-2a", "ap-northeast-2c"]
backup_s3_bucket = "victoryfairy-mysql-backup-dev"
domain_name      = "victoryfairy.com" # Route53 호스팅영역 + ACM 인증서 기준 도메인

# dev 전용 DB(퍼블릭 MySQL+Redis, 매일 restore)를 만들려면 본인 IP CIDR 을 넣으세요.
# 비워두면(미설정) dev DB 는 생성되지 않습니다(plan 에도 안 뜸).
# dev_db_allowed_cidrs = ["1.2.3.4/32", "5.6.7.8/32"]   # 허용할 개발자 IP 들(/32), 비우면 dev DB 미생성
# dev_db_use_eip       = true                            # dev DB 에 고정 IP(Elastic IP) 부여(stop/start 후 IP 유지)

# 운영 MySQL EC2 에 개발자 PC 가 직접 붙게 하려면 본인 IP CIDR 을 넣으세요.
# 퍼블릭 2a 서브넷에 보조 ENI + EIP 가 hot-attach 되고 3306·6379 가 열립니다(인스턴스 재생성 없음).
# 비워두면 퍼블릭 경로를 만들지 않고 SSM 포트포워딩만 남습니다(기본·권장).
# ⚠ 운영 데이터 호스트의 인터넷 노출입니다. /32 로 좁게, 필요 없어지면 비워서 제거하세요.
# mysql_public_access_cidrs = ["1.2.3.4/32"]
