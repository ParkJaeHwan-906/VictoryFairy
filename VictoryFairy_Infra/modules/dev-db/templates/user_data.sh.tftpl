#!/usr/bin/env bash
# =============================================================================
# dev DB 부트스트랩: MySQL + (fresh)Redis 자체 호스팅 (Amazon Linux 2023)
# -----------------------------------------------------------------------------
# 프로덕션 mysql-ec2 와 동일한 패턴(docker + EBS 마운트 + MySQL/Redis 컨테이너)이나,
# 백업 크론 대신 '매일 최신 덤프 복원(restore) 크론'을 건다. Redis 는 fresh(복원 안 함).
#   - 원본 프로덕션이 매일 18:10 UTC 에 s3://<bucket>/<prefix><TS>.sql.gz 로 덤프.
#   - dev 는 매일 restore_cron(기본 19:00 UTC = 04:00 KST, 원본 백업 이후)에 최신 .sql.gz 를 찾아 MySQL 에 복원해 데이터를 갱신.
#   - MySQL root 비밀번호는 '프로덕션과 동일한' SSM 파라미터에서 읽는다
#     (--all-databases 덤프에 mysql 권한 테이블이 포함되어 복원 후에도 비번 일관).
#
# ⚠ 이 스크립트는 "의도를 드러내는 뼈대"다. 프로덕션 반영 전 이미지 태그 고정,
#   MySQL 설정(my.cnf), Redis maxmemory 값, 헬스체크를 검토/보강할 것.
# =============================================================================
set -euxo pipefail

# ---------------------------------------------------------------------------
# 0) 파라미터 (Terraform templatefile 주입)
# ---------------------------------------------------------------------------
DATA_DEVICE="${data_volume_device_name}"          # 논리 지정값(/dev/sdf 등)
MOUNT_POINT="/mnt/mysql-data"
BACKUP_BUCKET="${backup_s3_bucket}"
BACKUP_PREFIX="${backup_s3_prefix}"
AWS_REGION="${aws_region}"
MYSQL_PW_SSM_PARAM="${mysql_root_password_ssm_parameter_name}"
INNODB_BUFFER_POOL="${innodb_buffer_pool_size}"
REDIS_MAXMEMORY="${redis_maxmemory}"
RESTORE_CRON="${restore_cron}"

# ---------------------------------------------------------------------------
# 1) 패키지: docker, awscli
# ---------------------------------------------------------------------------
dnf update -y
dnf install -y docker awscli
systemctl enable --now docker

# ---------------------------------------------------------------------------
# 2) EBS 데이터 볼륨 탐지 + 마운트 (프로덕션과 동일 패턴)
#    Nitro(t3)에서 EBS 는 /dev/nvme*n1 로 보여 논리명(/dev/sdf)과 다를 수 있다.
# ---------------------------------------------------------------------------
if [ -b "$DATA_DEVICE" ]; then
  RESOLVED_DEVICE="$DATA_DEVICE"
else
  RESOLVED_DEVICE="$(lsblk -dpno NAME,TYPE,MOUNTPOINT | awk '$2=="disk" && $3=="" {print $1}' | grep -v "$(findmnt -no SOURCE / | sed 's/p\?[0-9]*$//')" | head -n1)"
fi

# 파일시스템이 없으면(=신규 볼륨) 최초 포맷.
if ! blkid "$RESOLVED_DEVICE"; then
  mkfs -t xfs "$RESOLVED_DEVICE"
fi

mkdir -p "$MOUNT_POINT"
DATA_UUID="$(blkid -s UUID -o value "$RESOLVED_DEVICE")"
grep -q "$DATA_UUID" /etc/fstab || echo "UUID=$DATA_UUID $MOUNT_POINT xfs defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p "$MOUNT_POINT/mysql"

# ---------------------------------------------------------------------------
# 3) 시크릿: MySQL root 비밀번호는 SSM Parameter Store(SecureString)에서 조회.
#    프로덕션과 '동일한' 파라미터 — 덤프 복원 후에도 비번이 일관되도록.
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD="$(aws ssm get-parameter \
  --name "$MYSQL_PW_SSM_PARAM" \
  --with-decryption \
  --region "$AWS_REGION" \
  --query 'Parameter.Value' --output text)"

# ---------------------------------------------------------------------------
# 4) MySQL 컨테이너 — 데이터 디렉토리는 EBS 마운트 지점에 바인드.
#    ⚠ image 태그는 예시. 프로덕션은 불변 태그(예: mysql:8.0.x)로 고정할 것.
# ---------------------------------------------------------------------------
docker run -d --name mysql --restart unless-stopped \
  -p 3306:3306 \
  -e MYSQL_ROOT_PASSWORD="$MYSQL_ROOT_PASSWORD" \
  -v "$MOUNT_POINT/mysql:/var/lib/mysql" \
  mysql:8.0 \
  --innodb-buffer-pool-size="$INNODB_BUFFER_POOL"

# ---------------------------------------------------------------------------
# 5) Redis 컨테이너 — fresh(빈 상태). dev 는 복원하지 않는다(서비스 캐시/브로커 신선 시작).
# ---------------------------------------------------------------------------
docker run -d --name redis --restart unless-stopped \
  -p 6379:6379 \
  redis:7 \
  redis-server --maxmemory "$REDIS_MAXMEMORY" --maxmemory-policy allkeys-lru

# ---------------------------------------------------------------------------
# 6) restore 스크립트: s3 에서 최신 .sql.gz 를 찾아 MySQL 에 복원.
#    (프로덕션 백업 크론의 반대 방향 — dev 전용, 쓰기 없음/읽기만.)
# ---------------------------------------------------------------------------
cat >/usr/local/bin/mysql-restore.sh <<'RESTORE'
#!/usr/bin/env bash
set -euo pipefail
BUCKET="__BUCKET__"
PREFIX="__PREFIX__"
REGION="__REGION__"
PW_PARAM="__PW_PARAM__"

PW=$(aws ssm get-parameter --name "$PW_PARAM" --with-decryption --region "$REGION" --query 'Parameter.Value' --output text)

# prefix 하위 객체를 이름순 정렬 → 마지막(=최신 TS) .sql.gz 선택.
# 백업 파일명이 <TS>.sql.gz(예: 20260725-181000.sql.gz)라 사전식 정렬 = 시간순.
LATEST=$(aws s3 ls "s3://$BUCKET/$PREFIX" --region "$REGION" | grep -E '\.sql\.gz$' | sort | tail -n1 | awk '{print $NF}')
if [ -z "$LATEST" ]; then
  echo "no dump found under s3://$BUCKET/$PREFIX" >&2
  exit 1
fi

echo "restoring from s3://$BUCKET/$PREFIX$LATEST"
aws s3 cp "s3://$BUCKET/$PREFIX$LATEST" - --region "$REGION" \
  | zcat \
  | docker exec -i mysql mysql -uroot -p"$PW"
echo "restore done: $LATEST"
RESTORE

# 플레이스홀더를 실제 값으로 치환(작은따옴표 heredoc 이라 변수 확장이 안 되므로 sed 로 주입).
sed -i \
  -e "s|__BUCKET__|$BACKUP_BUCKET|g" \
  -e "s|__PREFIX__|$BACKUP_PREFIX|g" \
  -e "s|__REGION__|$AWS_REGION|g" \
  -e "s|__PW_PARAM__|$MYSQL_PW_SSM_PARAM|g" \
  /usr/local/bin/mysql-restore.sh
chmod +x /usr/local/bin/mysql-restore.sh

# 매일 restore_cron(UTC, 기본 0 19 * * * = 04:00 KST, 원본 백업 03:10 KST 이후)에 갱신.
echo "$RESTORE_CRON root /usr/local/bin/mysql-restore.sh >> /var/log/mysql-restore.log 2>&1" \
  > /etc/cron.d/mysql-restore

# ---------------------------------------------------------------------------
# 7) 최초 부팅 시 1회 즉시 복원 — cron 시각(restore_cron)까지 기다리지 않고 바로 데이터 확보.
#    MySQL 이 접속 가능해질 때까지 대기 후 restore. 실패해도 부팅은 계속(다음 cron 이 재시도).
# ---------------------------------------------------------------------------
for i in $(seq 1 60); do
  if docker exec mysql mysqladmin ping -uroot -p"$MYSQL_ROOT_PASSWORD" --silent 2>/dev/null; then
    break
  fi
  sleep 5
done
/usr/local/bin/mysql-restore.sh >> /var/log/mysql-restore.log 2>&1 || \
  echo "initial restore failed; will retry on cron" >> /var/log/mysql-restore.log
